<Project Sdk="Microsoft.NET.Sdk">
 
   <PropertyGroup>
     <TargetFramework>net10.0</TargetFramework>
     <ImplicitUsings>enable</ImplicitUsings>
     <Nullable>enable</Nullable>
     <GenerateDocumentationFile>true</GenerateDocumentationFile>
     <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
     <WasmComponentWorld>game-client</WasmComponentWorld>
     <NoWarn>$(NoWarn);1591</NoWarn>
   </PropertyGroup>
 
   <ItemGroup>
     <Wit Remove="wit\game.wit" />
     <Wit Remove="wit\game.g.wit" />
     <Wit Include="wit\game.g.wit" World="game-client" />
   </ItemGroup>

   <ItemGroup>
     <Compile Remove="MapTemplate\**" />
   </ItemGroup>
 
   <ItemGroup>
     <PackageReference Include="BytecodeAlliance.Componentize.DotNet.WitBindgen" Version="0.8.0-preview00011" />
   </ItemGroup>

   <ItemGroup>
     <ProjectReference Include="..\Realm.WasmBindgen\Realm.WasmBindgen.csproj"
                       OutputItemType="Analyzer"
                       ReferenceOutputAssembly="false" />
   </ItemGroup>

   <Target Name="AddXmlDocComment" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(GenerateDocumentationFile)' == 'true'">
     <PropertyGroup>
       <XmlDocFile>$(TargetDir)$(TargetName).xml</XmlDocFile>
     </PropertyGroup>
     <Exec Command="powershell -Command &quot;if (Test-Path '$(XmlDocFile)') { $p = '$(XmlDocFile)'; $c = '&lt;!-- This file is auto-generated by the Microsoft .NET SDK C# compiler (csc). Online documentation: https://learn.microsoft.com/en-us/dotnet/csharp/language-reference/xmldoc/ --&gt;'; $old = Get-Content $p -Raw; if (-not $old.StartsWith($c)) { Set-Content -Path $p -Value ($c + [Environment]::NewLine + $old) } }&quot;" />
   </Target>
 
 </Project>
