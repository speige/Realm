{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Lobby (Web)",
      "type": "coreclr",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Realm.Lobby/Realm.Lobby.csproj",
      "args": [
        "--urls",
        "http://0.0.0.0:5000"
      ],
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Run Simulation Tests",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Realm.Godot/Realm.Godot.csproj",
        "--filter",
        "FullyQualifiedName~SimulationTests"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "GODOT_BIN": "C:\\Program Files\\Godot_v4.7-stable_mono_win64\\Godot_v4.7-stable_mono_win64.exe"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Run All Tests",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Realm.Godot/Realm.Godot.csproj"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "GODOT_BIN": "C:\\Program Files\\Godot_v4.7-stable_mono_win64\\Godot_v4.7-stable_mono_win64.exe"
      },
      "console": "integratedTerminal"
    }
  ]
}
