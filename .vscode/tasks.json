{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Lobby (Web)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/Realm.Lobby/Realm.Lobby.csproj",
        "--urls",
        "http://0.0.0.0:5000"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run Simulation Tests",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Realm.Godot/Realm.Godot.csproj",
        "--filter",
        "FullyQualifiedName~SimulationTests"
      ],
      "options": {
        "env": {
          "GODOT_BIN": "C:\\Program Files\\Godot_v4.7-stable_mono_win64\\Godot_v4.7-stable_mono_win64.exe"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Realm.Godot/Realm.Godot.csproj"
      ],
      "options": {
        "env": {
          "GODOT_BIN": "C:\\Program Files\\Godot_v4.7-stable_mono_win64\\Godot_v4.7-stable_mono_win64.exe"
        }
      },
      "problemMatcher": []
    }
  ]
}
