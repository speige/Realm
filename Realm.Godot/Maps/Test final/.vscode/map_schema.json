{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MapUnitsRegistry",
  "type": "object",
  "properties": {
    "MapProperties": {
      "type": "object",
      "properties": {
        "MapName": {
          "type": "string"
        },
        "MapDescription": {
          "type": "string"
        },
        "SuggestedPlayers": {
          "type": "string"
        },
        "MinimapImage": {
          "type": "string"
        },
        "FogOfWarType": {
          "type": "string",
          "enum": ["visible", "grey", "black"]
        },
        "TerrainBaseHeight": {
          "type": "number",
          "minimum": 0
        },
        "ShadowIntensity": {
          "type": "number",
          "minimum": 0
        },
        "MapWidth": {
          "type": "integer",
          "minimum": 0
        },
        "CameraBoundsLeft": {
          "type": "number"
        },
        "CameraBoundsRight": {
          "type": "number"
        },
        "CameraBoundsTop": {
          "type": "number"
        },
        "CameraBoundsBottom": {
          "type": "number"
        },
        "MapHeight": {
          "type": "integer",
          "minimum": 0
        },
        "PlayableWidth": {
          "type": "integer",
          "minimum": 0
        },
        "PlayableHeight": {
          "type": "integer",
          "minimum": 0
        },
        "LoadingImage": {
          "type": "string"
        },
        "LoadingMusic": {
          "type": "string"
        },
        "LoadingTitle": {
          "type": "string"
        },
        "LoadingSubtitle": {
          "type": "string"
        },
        "LoadingBodyText": {
          "type": "string"
        },
        "HowToPlayInstructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "HowToPlayObjective": {
          "type": "string"
        },
        "Version": {
          "type": "string"
        },
        "Changelog": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["Version", "Date", "Details"],
            "properties": {
              "Version": { "type": "string" },
              "Date": { "type": "string" },
              "Details": { "type": "string" }
            }
          }
        },
        "PlayerSlots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["SlotId", "Name", "Color", "Faction", "Controller"],
            "properties": {
              "SlotId": { "type": "integer", "minimum": 0 },
              "Name": { "type": "string" },
              "Color": { "type": "string" },
              "Faction": { "type": "string" },
              "Controller": { "type": "string", "enum": ["HumanPlayer", "ComputerAi", "Neutral", "Hostile", "Open", "Closed"] },
              "AiType": { "type": "string" },
              "StartLocation": { "type": "string" },
              "CustomDecal": { "type": "string" }
            }
          }
        },
        "Teams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["TeamName", "Slots"],
            "properties": {
              "TeamName": { "type": "string" },
              "Slots": {
                "type": "array",
                "items": { "type": "integer" }
              }
            }
          }
        },
        "CustomAbilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["AbilityId", "Name", "Description", "AbilityType"],
            "properties": {
              "AbilityId": { "type": "string" },
              "Name": { "type": "string" },
              "Description": { "type": "string" },
              "AbilityType": { "type": "string", "enum": ["target_spell", "instant_spell", "passive"] },
              "ManaCost": { "type": "number", "minimum": 0 },
              "Cooldown": { "type": "number", "minimum": 0 },
              "TargetRange": { "type": "number", "minimum": 0 },
              "VisualEffect": { "type": "string" },
              "CastSound": { "type": "string" },
              "IconPath": { "type": "string" },
              "AppliedStatusEffects": {
                "type": "array",
                "items": { "type": "string" }
              },
              "AreaOfEffectRadius": { "type": "number", "minimum": 0 },
              "Damage": { "type": "number", "minimum": 0 },
              "Healing": { "type": "number", "minimum": 0 },
              "SummonedUnitId": { "type": "string" },
              "SummonCount": { "type": "integer", "minimum": 1 },
              "SummonDuration": { "type": "number", "minimum": 0 }
            }
          }
        },
        "CustomUpgrades": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["UpgradeId", "Name", "Description"],
            "properties": {
              "UpgradeId": { "type": "string" },
              "Name": { "type": "string" },
              "Description": { "type": "string" },
              "CostGold": { "type": "number", "minimum": 0 },
              "CostWood": { "type": "number", "minimum": 0 },
              "CostStone": { "type": "number", "minimum": 0 },
              "ResearchTime": { "type": "number", "minimum": 0 },
              "Requirement": { "type": "string" },
              "MaxLevel": { "type": "integer", "minimum": 1 },
              "AffectedUnitIds": {
                "type": "array",
                "items": { "type": "string" }
              },
              "MaxHpBonus": { "type": "number" },
              "DamageBonus": { "type": "number" },
              "ArmorBonus": { "type": "number" },
              "SpeedBonus": { "type": "number" }
            }
          }
        },
        "CustomItems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ItemId", "Name", "Description", "ItemClass"],
            "properties": {
              "ItemId": { "type": "string" },
              "Name": { "type": "string" },
              "Description": { "type": "string" },
              "ItemClass": { "type": "string", "enum": ["consumable", "equipment", "quest"] },
              "CostGold": { "type": "number", "minimum": 0 },
              "UseAbility": { "type": "string" },
              "ChargeCount": { "type": "integer", "minimum": 0 },
              "CooldownLink": { "type": "string" },
              "CanDrop": { "type": "boolean" },
              "ItemLevel": { "type": "integer", "minimum": 0 },
              "IconPath": { "type": "string" },
              "PassiveStatusEffects": {
                "type": "array",
                "items": { "type": "string" }
              },
              "GrantedWeapons": {
                "type": "array",
                "items": { "type": "string" }
              },
              "IsContainer": { "type": "boolean" },
              "ContainerSize": { "type": "integer", "minimum": 0 },
              "Requirements": { "type": "string" }
            }
          }
        },
        "CustomWeapons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["WeaponId", "Name", "Damage", "Range", "AttackCooldown", "AttackType"],
            "properties": {
              "WeaponId": { "type": "string" },
              "Name": { "type": "string" },
              "Damage": { "type": "number", "minimum": 0 },
              "Range": { "type": "number", "minimum": 0 },
              "AttackCooldown": { "type": "number", "minimum": 0 },
              "AttackType": { "type": "string", "enum": ["melee", "ranged", "none"] },
              "ProjectileSpeed": { "type": "number", "minimum": 0 },
              "VisualEffect": { "type": "string" },
              "AttackSound": { "type": "string" },
              "ProjectileModelPath": { "type": "string" },
              "ImpactVisualEffect": { "type": "string" },
              "ImpactSound": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": {
    "type": "object",
    "required": [
      "UnitId",
      "Name",
      "Description",
      "MaxHp",
      "Damage",
      "Range",
      "Armor",
      "Speed",
      "AttackCooldown",
      "ScanRadius",
      "CostGold",
      "CostWood",
      "CostStone",
      "ProductionTime",
      "PopCost",
      "AttackType",
      "ArmorType",
      "GoldBounty"
    ],
    "properties": {
      "UnitId": {
        "type": "string"
      },
      "Name": {
        "type": "string"
      },
      "Description": {
        "type": "string"
      },
      "MaxHp": {
        "type": "number",
        "minimum": 0
      },
      "Damage": {
        "type": "number",
        "minimum": 0
      },
      "Range": {
        "type": "number",
        "minimum": 0
      },
      "Armor": {
        "type": "number",
        "minimum": 0
      },
      "Speed": {
        "type": "number",
        "minimum": 0
      },
      "AttackCooldown": {
        "type": "number",
        "minimum": 0
      },
      "ScanRadius": {
        "type": "number",
        "minimum": 0
      },
      "CostGold": {
        "type": "number",
        "minimum": 0
      },
      "CostWood": {
        "type": "number",
        "minimum": 0
      },
      "CostStone": {
        "type": "number",
        "minimum": 0
      },
      "ProductionTime": {
        "type": "number",
        "minimum": 0
      },
      "PopCost": {
        "type": "integer",
        "minimum": 0
      },
      "AttackType": {
        "type": "string",
        "enum": ["melee", "ranged", "none"]
      },
      "ArmorType": {
        "type": "string",
        "enum": ["light", "heavy", "building"]
      },
      "GoldBounty": {
        "type": "number",
        "minimum": 0
      },
      "ModelPath": {
        "type": "string"
      },
      "BuildOptions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "IsHero": {
        "type": "boolean"
      },
      "Abilities": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "XpBounty": {
        "type": "number",
        "minimum": 0
      },
      "Weapons": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "StartingItems": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "Upgrades": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "MovementType": {
        "type": "string",
        "enum": ["ground", "air", "amphibious", "none"]
      },
      "PathingCapabilities": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["shallow_water", "deep_water", "flying", "ground", "unpathable"]
        }
      },
      "StatusEffects": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "SoundEvents": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "PortraitModelPath": {
        "type": "string"
      }
    }
  }
}
