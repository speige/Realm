<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="NpmInstall" BeforeTargets="Build" Condition="!Exists('node_modules')">
    <Exec Command="npm install" />
  </Target>

  <Target Name="NpmBuild" AfterTargets="NpmInstall" BeforeTargets="Build">
    <Exec Command="npm run compile" />
  </Target>

  <Target Name="SyncToEmbedded" AfterTargets="Build">
    <ItemGroup>
      <DistFiles Include="dist\**\*.*" />
      <MediaFiles Include="media\**\*.*" />
      <RootFiles Include="package.json;map_schema.json" />
    </ItemGroup>

    <!-- 1. Copy to Godot project source tree for git & distribution -->
    <Copy SourceFiles="@(DistFiles)" DestinationFolder="../Realm.Godot/vscode_extensions_dist/speige.realm-map-editor/dist/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MediaFiles)" DestinationFolder="../Realm.Godot/vscode_extensions_dist/speige.realm-map-editor/media/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RootFiles)" DestinationFolder="../Realm.Godot/vscode_extensions_dist/speige.realm-map-editor/" SkipUnchangedFiles="true" />

    <!-- 2. Auto-update installed extension inside user-data-dir/extensions if present -->
    <Copy SourceFiles="@(DistFiles)" DestinationFolder="../Realm.Godot/vscode_embedded/user-data-dir/extensions/speige.realm-map-editor-1.0.0/dist/%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('../Realm.Godot/vscode_embedded/user-data-dir/extensions/speige.realm-map-editor-1.0.0')" />
    <Copy SourceFiles="@(MediaFiles)" DestinationFolder="../Realm.Godot/vscode_embedded/user-data-dir/extensions/speige.realm-map-editor-1.0.0/media/%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('../Realm.Godot/vscode_embedded/user-data-dir/extensions/speige.realm-map-editor-1.0.0')" />
    <Copy SourceFiles="@(RootFiles)" DestinationFolder="../Realm.Godot/vscode_embedded/user-data-dir/extensions/speige.realm-map-editor-1.0.0/" SkipUnchangedFiles="true" Condition="Exists('../Realm.Godot/vscode_embedded/user-data-dir/extensions/speige.realm-map-editor-1.0.0')" />
  </Target>
</Project>
